# --- Base de donnees ---
DATABASE_URL=postgresql+psycopg2://odoo:odoo@localhost:5432/medicacom

# --- Securite / JWT ---
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- API ---
API_V1_PREFIX=/api/v1
PROJECT_NAME=Medicacom AOI Transformation

# --- CORS (liste separee par des virgules) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Compte admin cree par le seed ---
FIRST_SUPERUSER_EMAIL=admin@medicacom.com
FIRST_SUPERUSER_PASSWORD=medicacom2026

# --- Environnement ---
# development : l'ecran de connexion propose une aide listant les comptes du seed.
# production  : cette aide n'existe plus, l'endpoint repond 404.
ENVIRONMENT=development

# Mot de passe commun aux comptes de demonstration, affiche par cette aide.
# Laisser vide pour ne jamais le publier. A vider imperativement en production.
DEMO_PASSWORD=medicacom2026
